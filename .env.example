
LLM_PROVIDER=anthropic 
LLM_MODEL=claude-haiku-5-5
LLM_API_KEY=
# Modelo para LLM-as-judge en el benchmark (vacío = mismo que LLM_MODEL)
LLM_JUDGE_MODEL=
LLM_EFFORT=low
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50

WIKI_CONTACT=
WIKI_MIN_INTERVAL_S=1.0

CHUNK_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
MIN_SECTION_TOKENS=80
TOP_K_BRANCH=20
TOP_K_FINAL=5
FUSION_METHOD=weighted
FUSION_W_DENSE=0.6
FUSION_W_LEXICAL=0.4
EVIDENCE_TAU=0.30
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_TOP_N=10

# HF_TOKEN=
# HF_HOME=
LOG_LEVEL=INFO

# API / UI
API_HOST=127.0.0.1
API_PORT=8000
# Token para iniciar sesión como administrador en la UI (vacío = nadie es admin)
ADMIN_TOKEN=
# Firma de la cookie de sesión (vacío = se genera al arrancar; las sesiones no sobreviven reinicios)
SESSION_SECRET=


LLM_PROVIDER=anthropic 
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
# Modelo para LLM-as-judge en el benchmark (vacío = mismo que LLM_MODEL)
LLM_JUDGE_MODEL=
LLM_EFFORT=low
LLM_PRICE_INPUT_PER_MTOK=4.0
LLM_PRICE_OUTPUT_PER_MTOK=20.0

WIKI_CONTACT=
WIKI_MIN_INTERVAL_S=1.0

CHUNK_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
MIN_SECTION_TOKENS=80
TOP_K_BRANCH=20
TOP_K_FINAL=5
FUSION_METHOD=weighted
FUSION_W_DENSE=0.6
FUSION_W_LEXICAL=0.4
EVIDENCE_TAU=0.30

# HF_TOKEN=
# HF_HOME=
LOG_LEVEL=INFO
